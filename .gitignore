# Deny-all by default (whitelist only what ships in this repo)
*
.*

# Repository metadata & root config
!.gitignore
!.dockerignore
!.goreleaser.yaml
!.github/
!.github/**
!.govulncheck-ignore.yaml

!Dockerfile
!Dockerfile.release
!GNUmakefile
!Makefile
!README.md
!ROADMAP.md
!SPECIFICATIONS.md
!VERSION
!LICENSE
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!codecov.yml
!go.mod
!go.sum
!configs/
!configs/**

!contrib/
!contrib/**

# OpenBSD port: distinfo is generated with makesum in a ports checkout (not in repo)
contrib/openbsd/port/distinfo
# GoReleaser before hook generates this for nfpm (.deb/.rpm)
contrib/man/man1/kzero.1.gz

# Source and documentation
!cmd/
!cmd/**
!pkg/
!pkg/**
!docs/
!docs/**

# Build output dir: keep directory in git with a placeholder only (see Makefile → bin/)
!bin/
!bin/.keep

# Local / OS noise (redundant with *; keeps intent visible)
.DS_Store

!/cmd/
!/cmd/**

!/internal/
!/internal/**

!/examples/
!/examples/**

!/tools/
!/tools/**

!/configs/
!/configs/**
